{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../packages ../../docs",
  "redirects": [{ "source": "/docs", "destination": "/docs/", "permanent": true }],
  "rewrites": [
    {
      "source": "/docs/",
      "destination": "https://tryquickdraw-docs.vercel.app/docs/"
    },
    {
      "source": "/docs/:path(.*)",
      "destination": "https://tryquickdraw-docs.vercel.app/docs/:path"
    }
  ]
}
