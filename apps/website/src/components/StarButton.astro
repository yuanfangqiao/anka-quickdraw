---
// The "Star on GitHub" call to action. Two looks: `paper` for the hero, on the
// light page background, and `cream` for the dark support card.
//
// The count is rendered at build time and topped up client-side, so it never
// pops in from empty.
import { GITHUB_URL } from '../consts.js'

const { stars = 0, variant = 'paper', label = 'Star on GitHub' } = Astro.props
---

<a
  class:list={['star-btn', variant]}
  href={GITHUB_URL}
  rel="noopener"
  aria-label={stars ? `${label} — ${stars} stars` : label}
  data-star-btn
>
  <span class="sb-face">
    <svg class="sb-gh" viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"
      ><path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
      /></svg
    >
    <span class="sb-label">{label}</span>
  </span>
  <span class="sb-count" data-star-count hidden={!stars}>
    <svg class="sb-star" viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M12 1.6l3.1 6.7 7.3.9-5.4 5 1.4 7.2L12 17.8l-6.4 3.6L7 14.2 1.6 9.2l7.3-.9L12 1.6z"
      /></svg
    >
    <span class="sb-num" data-star-num>{stars || ''}</span>
  </span>
</a>

<script>
  import { loadStarCount } from '../lib/liveStars.js'

  const buttons = document.querySelectorAll('[data-star-btn]')
  if (buttons.length) {
    loadStarCount()
      .then((stars) => {
        if (typeof stars !== 'number' || stars < 1) return
        for (const btn of buttons) {
          btn.querySelector('[data-star-num]').textContent = String(stars)
          btn.querySelector('[data-star-count]').hidden = false
          const label = btn.querySelector('.sb-label')?.textContent ?? 'Star on GitHub'
          btn.setAttribute('aria-label', `${label} — ${stars} stars`)
        }
      })
      .catch(() => {})
  }
</script>

<style>
  .star-btn {
    display: inline-flex; align-items: stretch; border-radius: 999px;
    font-weight: 650; font-size: 15.5px; line-height: 1;
    text-decoration: none; overflow: hidden; isolation: isolate;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }
  .star-btn:hover { text-decoration: none; transform: translateY(-1px); }
  .star-btn:active { transform: translateY(0); }

  /* When the button is stretched wider than its content — full-bleed on a
     narrow screen — the face absorbs the slack so the divider and the count
     stay pinned to the right edge instead of drifting to the middle. */
  .sb-face {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    flex: 1 1 auto; padding: 11px 17px 11px 20px;
  }
  .sb-count {
    display: flex; align-items: center; gap: 6px; flex: none;
    padding: 11px 19px 11px 15px;
    font-variant-numeric: tabular-nums; letter-spacing: 0.01em;
  }
  .sb-count[hidden] { display: none; }
  .sb-face + .sb-count { border-left: 1px solid; }
  .sb-gh { flex: none; }
  .sb-star {
    width: 15px; height: 15px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linejoin: round;
    transition: transform 220ms cubic-bezier(.2,.9,.3,1.4), fill 180ms ease;
  }
  /* The star fills in and kicks when you go for it. */
  .star-btn:hover .sb-star { transform: rotate(-14deg) scale(1.16); }

  /* On paper: bold outline to sit beside the solid dark primary button. */
  .paper {
    color: var(--ink);
    border: 1.5px solid var(--ink);
    background: linear-gradient(180deg, #fff 0%, #f5f2ea 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 2px 0 -1px rgba(28, 27, 24, 0.06);
  }
  .paper:hover {
    background: linear-gradient(180deg, #fff 0%, #efece2 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 8px 18px -10px rgba(28, 27, 24, 0.45);
  }
  .paper .sb-face + .sb-count { border-left-color: rgba(28, 27, 24, 0.16); }
  .paper .sb-star { color: #e0a106; }
  .paper:hover .sb-star { fill: #ffd154; }

  /* On the dark support card: cream, with the star already lit. */
  .cream {
    color: #14130f;
    background: linear-gradient(180deg, #fffefb 0%, #ece8dc 100%);
    box-shadow: 0 2px 0 rgba(20, 19, 15, 0.25), 0 10px 26px -14px rgba(0, 0, 0, 0.8);
  }
  .cream:hover {
    background: linear-gradient(180deg, #fff 0%, #f4f1e7 100%);
    box-shadow: 0 2px 0 rgba(20, 19, 15, 0.25), 0 14px 30px -12px rgba(255, 209, 84, 0.45);
  }
  .cream .sb-face + .sb-count { border-left-color: rgba(20, 19, 15, 0.14); }
  .cream .sb-star { color: #e0a106; fill: #ffd154; }

  .star-btn:focus-visible { outline: 2.5px solid var(--accent); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .star-btn, .sb-star { transition: none; }
    .star-btn:hover { transform: none; }
    .star-btn:hover .sb-star { transform: none; }
  }

  @media (max-width: 460px) {
    .star-btn { font-size: 16px; }
    .sb-face { padding: 13px 15px 13px 18px; }
    .sb-count { padding: 13px 18px 13px 14px; }
  }
</style>
